<!DOCTYPE rules [
    <!ENTITY weekdays "måndags?|tisdags?|onsdags?|torsdags?|fredags?|lördags?|söndags?">
    <!ENTITY abbrevWeekdays "mån?|tis?|ons?|tor?|fre?|lör?|sön?">
    <!ENTITY months "januaris?|februaris?|mars'?|aprils?|majs?|junis?|julis?|augustis?|septembers?|oktobers?|novembers?|decembers?">
    <!ENTITY abbrevMonths "jan|feb|mar|apr|maj|ju[ln]|aug|sept?|okt|nov|dec">
]>
<rules lang="sv" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../../../../../../../languagetool-core/src/main/resources/org/languagetool/rules/rules.xsd">
  <!-- ====================================================================== -->
  <!-- Särskrivningar -->
  <!-- ====================================================================== -->
  <category id="CAT1" name="Särskrivning rekommenderas">
    <rule id="efter-hand" name="Särskrivning 'efterhand (efter hand)'">
      <pattern>
        <token>efterhand</token>
      </pattern>
      <message>Felaktig sammanskrivning. Menade du <suggestion>efter hand</suggestion>?</message>
      <example correction="efter hand">Det visade sig <marker>efterhand</marker> att orden borde särskrivas.</example>
    </rule>
  </category>
  <category id="CAT2" name="Sammanskrivning rekommenderas">
    <rule id="ALLT_MER" name="Allt mer bör ej särskrivas">
      <pattern>
        <token>allt</token>
        <token>mer</token>
      </pattern>
      <message>Enligt tt-språket och Svenska språknämnden bör ordet <suggestion>alltmer</suggestion> ej särskrivas.</message>
      <example correction="alltmer">Det blir <marker>allt mer</marker> vanligt att folk särskriver.</example>
    </rule>
  </category>
  <!-- ====================================================================== -->
  <!-- Punkter efter förkortningar -->
  <!-- ====================================================================== -->
  <category id="CAT3" name="Punkt vid förkortning">
    <rule id="M_FL" name="Förkortningen skrivs normalt med punkter (m.fl.)">
      <pattern>
        <token>m</token>
        <token>fl</token>
      </pattern>
      <message>Denna förkortning skrivs i regel med punkter: <suggestion>m.fl.</suggestion>.</message>
      <example correction="m.fl.">Vi tar med oss Maria, Jens, Sara <marker>m fl</marker> och åker till Jönköping.</example>
    </rule>
    <rule default="off" id="T_EX"
          name="Förkortningen skrivs normalt med punkter (t.ex.)">
      <pattern>
        <token>t</token>
        <token>ex</token>
      </pattern>
      <message>Denna förkortning skrivs i regel med punkter: <suggestion>t.ex.</suggestion>.</message>
      <example>Vi tar <marker>t.ex.</marker> fem myror och fyra elefanter. </example>
      <example correction="t.ex.">Vi tar <marker>t ex</marker> fem myror och fyra elefanter.</example>
    </rule>
    <rule default="off" id="TEX"
          name="Förkortningen skrivs normalt med punkter (t.ex.)">
      <pattern>
        <token>tex</token>
      </pattern>
      <message>Denna förkortning skrivs i regel med punkter: <suggestion>t.ex.</suggestion>. </message>
      <example>Vi tar <marker>t.ex.</marker> fem myror och fyra elefanter. </example>
      <example correction="t.ex.">Vi tar <marker>tex</marker> fem myror och fyra elefanter. </example>
    </rule>
  </category>
  <!-- ====================================================================== -->
  <!-- Grammatik -->
  <!-- ====================================================================== -->
  <category id="GRAMMAR" name="Grammatik">
    <rule id="JJ.OCH_n-ord.NN" name="Rätt böjning av adjektivet">
      <pattern>
        <token>ett</token>
        <token postag="JJ:P." postag_regexp="yes">
          <exception postag="JJ:PN"/>
        </token>
        <!-- All adjectives except the ones in neuter -->
        <token postag="NN:OF:S.*" postag_regexp="yes"/>
      </pattern>
      <message>Adjektivet är böjt i positiv utrum (\2) och bör då föregås av ordet "en" istället för "ett", alternativt böjas i positiv neutrum. Menade du: <suggestion>en \2 \3</suggestion>?</message>
      <example correction="en mörk kväll">Det var <marker>ett mörk kväll</marker>. </example>
    </rule>
    <rule id="JJ.OCH_t-ord.NN" name="Rätt böjning av adjektivet">
      <pattern>
        <token>en</token>
        <token postag="JJ:P." postag_regexp="yes">
          <exception postag="JJ:PU"/>
        </token>
        <token postag="NN:OF:S.*" postag_regexp="yes"/>
      </pattern>
      <message>Adjektivet "\2" är böjt i positiv neutrum och bör då föregås av ordet "ett" istället för "en", alternativt böjas i positiv utrum. <suggestion>ett \2 \3</suggestion></message>
      <example correction="ett mörkt rum">Det var <marker>en mörkt rum</marker>. </example>
    </rule>
    <rule id="DEN.JJ.NEUTRAL_n-ord.NN" name="Rätt bestämd artikel (den/det)">
      <pattern>
        <token>den</token>
        <token postag="JJ:BF">
          <!-- "hela" (whole) overwhelmingly starts fixed adverbial phrases
               ("hela tiden", "hela dagen", ...) unrelated to a preceding
               den/det that just happens to sit before them, verified
               against real corpus text (UD Talbanken + LinES, ~11.7k
               sentences) before excluding rather than assuming. "bra" is
               invariant (same form as adjective and adverb), also excluded. -->
          <exception regexp="yes">hela|bra</exception>
        </token>
        <token postag="NN:BF:S.*:NEU" postag_regexp="yes"/>
      </pattern>
      <message>Substantivet "\3" är neutrum (ett-ord) och bör då föregås av "det" istället för "den". Menade du: <suggestion>det \2 \3</suggestion>?</message>
      <example correction="det stora huset">Jag såg <marker>den stora huset</marker>.</example>
      <example>Han höll den hela tiden.</example>
    </rule>
    <rule id="DET.JJ.UTRUM_t-ord.NN" name="Rätt bestämd artikel (den/det)">
      <antipattern>
        <!-- "för det X" (för det första/andra/tredje...) is a fixed
             idiomatic sentence/clause-opener ("firstly"/"secondly"/...),
             invariant regardless of what noun happens to follow, found as
             a real false positive against the full corpus: "För det
             första ändringen av begreppet godkänd sökande...", "För det
             första upphovsmännen.", "För det första:" all use this
             pattern as a heading/label, not as genuine "det" + adjective
             + noun agreement, confirmed by checking every "för det X"
             occurrence in Talbanken+LinES, all shaped this way, none was
             a genuine attributive use. Only "första" is attested in this
             corpus, but the idiom itself isn't specific to it (för det
             andra/tredje/... are the same construction), so this matches
             any JJ:BF rather than hardcoding "första". Same idiom-antipattern
             shape as "före detta" on DETTA.UTRUM_t-ord.NN below.

             Known tradeoff, not airtight: "för" is also an ordinary
             preposition, so a genuine mid-sentence error of the exact
             same shape ("...för det första bilen jag köpte...", lowercase,
             not sentence-initial) would also be suppressed by this
             antipattern and go uncaught. Accepted deliberately, same
             precision-over-recall bias as the rest of this project; no
             such case was found in the corpus, and every real hit for
             this exact shape was the idiom. -->
        <token>för</token>
        <token>det</token>
        <token postag="JJ:BF"/>
        <token postag="NN:BF:S.*:UTR" postag_regexp="yes"/>
      </antipattern>
      <pattern>
        <token>det</token>
        <token postag="JJ:BF">
          <!-- see DEN.JJ.NEUTRAL_n-ord.NN above for why these are excluded -->
          <exception regexp="yes">hela|bra</exception>
        </token>
        <token postag="NN:BF:S.*:UTR" postag_regexp="yes"/>
      </pattern>
      <message>Substantivet "\3" är utrum (en-ord) och bör då föregås av "den" istället för "det". Menade du: <suggestion>den \2 \3</suggestion>?</message>
      <example correction="den stora bilen">Jag såg <marker>det stora bilen</marker>.</example>
      <example>Han klarar det bra redan nu.</example>
      <example>Jag visste det hela tiden.</example>
      <example>För det första ändringen av begreppet godkänd sökande, som tillåter alla personer.</example>
    </rule>
    <rule id="DENNA.NEUTRAL_n-ord.NN" name="Rätt genus på demonstrativt pronomen (denna/detta)">
      <pattern>
        <token>denna</token>
        <!-- Nominative indefinite singular neuter only, not "S.*" style
             wildcarding: mined against 17,426 real UD Talbanken+LinES
             sentences (2026), and the naive "S.*" pattern used by the
             sibling possessive-pronoun rules below would ALSO match a
             genitive noun here (NN:OF:SIN:GEN:NEU), which turned up two
             real false positives in the corpus ("denna 1600-talets
             [borgerliga] patricierstad", "hela detta vildmarkens
             hemlighetsfulla liv"): the demonstrative there actually
             agrees with a head noun one word further on, past an
             intervening genitive modifier, not with the genitive noun
             itself. Anchoring to :NOM excludes those without needing an
             exception list.

             The full corpus run also surfaced two more real false
             positives once :NOM was in place: "denna var" (var/NN:NEU is
             the rare noun "var" = pus, same ambiguity as the existing
             "grund|var" exception on the sibling possessive-pronoun rules
             below) and "denna ... framträdande roll" (framträdande is
             functioning as an adjective/participle here, modifying the
             real head noun "roll" one word later, but the dictionary
             also carries a genuine NN:NEU reading for it, "ett
             framträdande" = a performance/appearance).

             "grund" and "vara" are added here too even without an
             observed corpus hit for this specific rule: dictionary tag
             dump confirms both carry an ambiguous NN:NEU reading
             (grund/NN:OF:SIN:NOM:NEU alongside its usual UTR reading;
             vara/NN:OF:SIN:NOM:NEU alongside its UTR reading and its verb
             readings), the same class of risk already proven real for
             "var" and "framträdande" above, and "grund" already carries
             this exact exception on every sibling rule below. -->
        <token postag="NN:OF:SIN:NOM:NEU">
          <exception regexp="yes">grund|var|vara|framträdande</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är neutrum (ett-ord) och styr då "detta" istället för "denna". Menade du: <suggestion>detta \2</suggestion>?</message>
      <example correction="detta hus">Jag såg <marker>denna hus</marker>.</example>
      <example>Amsterdams centrum är i våra dagar ett exempel på denna 1600-talets borgerliga patricierstad.</example>
      <example>Denna var i vanliga fall ett ogästvänligt ställe.</example>
      <example>Varför ges nu äktenskapet denna framträdande roll i en kristen sexualetik?</example>
    </rule>
    <rule id="DETTA.UTRUM_t-ord.NN" name="Rätt genus på demonstrativt pronomen (denna/detta)">
      <!-- Shipped OFF by default at first, unlike its DENNA.NEUTRAL_n-ord.NN
           sibling above, which passed the same full-corpus check with
           zero exceptions needed. This direction is structurally
           different: "detta" is used pronominally/anaphorically (as a
           free-standing "this", referring back to an idea) far more
           often in real text than as a determiner directly before a
           noun, and the word immediately after it is overwhelmingly a
           verb, preposition, or conjunction rather than a noun. The
           risk was that many of Swedish's most common short function
           words happen to ALSO have a rare, genuine noun reading in the
           compiled dictionary (för, kan, vara, med, en, skulle, ...;
           also grund and faktum), and every one of those sits directly
           after "detta" constantly in ordinary text. Nine such words
           turned up as real false positives in one 17,760-sentence pass.

           Enabled 2026-09-10 after fixing this at the correct layer:
           DETTA_FOLLOWER_NOT_NOUN in disambiguation.xml now removes the
           ambiguous NN:OF:SIN:NOM:UTR reading from exactly these nine
           words when they immediately follow "detta", so this rule's own
           pattern below no longer needs (or carries) an exception list
           for them at all, cleaner than growing one here the way the
           older rules in this file do. Re-verified 0 false positives
           against the full corpus after the change, same
           TreebankRuleRegressionCheck as before. See the disambiguation
           rule's own comment for the tradeoff this still doesn't remove:
           it's the same finite 9-word list, just correctly placed. -->
      <antipattern>
        <!-- "före detta" (former/ex-) is a fixed, invariant idiom: "detta"
             here doesn't agree with anything at all, it's not acting as a
             demonstrative. Confirmed as a real false positive against the
             same corpus once the :NOM anchoring and exceptions below
             (see DENNA.NEUTRAL_n-ord.NN) are in place. -->
        <token>före</token>
        <token>detta</token>
        <token postag="NN:OF:SIN:NOM:UTR"/>
      </antipattern>
      <pattern>
        <token>detta</token>
        <token postag="NN:OF:SIN:NOM:UTR"/>
      </pattern>
      <message>Substantivet "\2" är utrum (en-ord) och styr då "denna" istället för "detta". Menade du: <suggestion>denna \2</suggestion>?</message>
      <example correction="denna bil">Jag såg <marker>detta bil</marker>.</example>
      <example>Han är en före detta rökare.</example>
      <example>Hela detta vildmarkens hemlighetsfulla liv pulserar i skogen.</example>
      <example>Detta kan skada programmet.</example>
      <example>Många anser detta vara en naturlig följd av systemet.</example>
      <example>Jag nämner detta med respekt.</example>
      <example>Det var där, i detta centralafrikanska territorium, som allt hände.</example>
      <example>Jag nämner detta för Shahar.</example>
      <example>Nedslående är att detta faktum inte uppmärksammats.</example>
    </rule>
    <rule id="SIN.NEUTRAL_n-ord.NN" name="Rätt genus på reflexivt possessivpronomen (sin/sitt)">
      <pattern>
        <token>sin</token>
        <token postag="NN:OF:S.*:NEU" postag_regexp="yes">
          <!-- "grund" (foundation/basis) is overwhelmingly used as utrum
               ("sin grund" = its basis, in the very common "ha sin grund
               i" construction); it also has a genuine but rare neuter
               reading ("ett grund" = a shoal/shallows), verified against
               real corpus text (UD Talbanken + LinES) before excluding. -->
          <exception regexp="yes">grund|var</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är neutrum (ett-ord) och styr då "sitt" istället för "sin". Menade du: <suggestion>sitt \2</suggestion>?</message>
      <example correction="sitt hus">Han sålde <marker>sin hus</marker>.</example>
      <example>Den gemenskapen har sin grund i familjen.</example>
    </rule>
    <rule id="SITT.UTRUM_t-ord.NN" name="Rätt genus på reflexivt possessivpronomen (sin/sitt)">
      <pattern>
        <token>sitt</token>
        <token postag="NN:OF:S.*:UTR" postag_regexp="yes">
          <!-- "för" is overwhelmingly a preposition/conjunction/adverb; its
               rare noun reading ("en för" = a ship's bow) false-matched
               "göra sitt för att ..." (a fixed idiom, "do one's part",
               where "sitt" doesn't govern "för" at all), verified against
               real corpus text before excluding. -->
          <exception>för</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är utrum (en-ord) och styr då "sin" istället för "sitt". Menade du: <suggestion>sin \2</suggestion>?</message>
      <example correction="sin bil">Han sålde <marker>sitt bil</marker>.</example>
      <example>Kommissionen kommer att göra sitt för att föra arbetet framåt.</example>
    </rule>
    <rule id="MIN.NEUTRAL_n-ord.NN" name="Rätt genus på possessivpronomen (min/mitt)">
      <pattern>
        <token>min</token>
        <token postag="NN:OF:S.*:NEU" postag_regexp="yes">
          <!-- "grund": same ambiguity as SIN.NEUTRAL_n-ord.NN above. "var"
               is overwhelmingly the past tense of "vara" (was), but has a
               real, rare neuter noun reading ("var" = pus, medical), which
               matched "min var" where "min" is itself being used as a noun
               ("en min" = a facial expression/countenance) rather than a
               possessive, e.g. "hennes min var inte bara kosmetisk" (her
               expression was not just cosmetic), verified against real
               corpus text before excluding. -->
          <exception regexp="yes">grund|var</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är neutrum (ett-ord) och styr då "mitt" istället för "min". Menade du: <suggestion>mitt \2</suggestion>?</message>
      <example correction="mitt hus">Jag sålde <marker>min hus</marker>.</example>
      <example>Det är fantastiskt hur min grund höll under stormen.</example>
      <example>Moderns omedgörliga min var inte bara kosmetisk.</example>
    </rule>
    <rule id="MITT.UTRUM_t-ord.NN" name="Rätt genus på possessivpronomen (min/mitt)">
      <pattern>
        <token>mitt</token>
        <token postag="NN:OF:S.*:UTR" postag_regexp="yes">
          <!-- same "för" ambiguity as SITT.UTRUM_t-ord.NN above -->
          <exception>för</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är utrum (en-ord) och styr då "min" istället för "mitt". Menade du: <suggestion>min \2</suggestion>?</message>
      <example correction="min bil">Jag sålde <marker>mitt bil</marker>.</example>
    </rule>
    <rule id="DIN.NEUTRAL_n-ord.NN" name="Rätt genus på possessivpronomen (din/ditt)">
      <pattern>
        <token>din</token>
        <token postag="NN:OF:S.*:NEU" postag_regexp="yes">
          <exception regexp="yes">grund|var</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är neutrum (ett-ord) och styr då "ditt" istället för "din". Menade du: <suggestion>ditt \2</suggestion>?</message>
      <example correction="ditt hus">Du sålde <marker>din hus</marker>.</example>
    </rule>
    <rule id="DITT.UTRUM_t-ord.NN" name="Rätt genus på possessivpronomen (din/ditt)">
      <pattern>
        <token>ditt</token>
        <token postag="NN:OF:S.*:UTR" postag_regexp="yes">
          <exception>för</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är utrum (en-ord) och styr då "din" istället för "ditt". Menade du: <suggestion>din \2</suggestion>?</message>
      <example correction="din bil">Du sålde <marker>ditt bil</marker>.</example>
    </rule>
    <rule id="VAR.NEUTRAL_n-ord.NN" name="Rätt genus på possessivpronomen (vår/vårt)">
      <pattern>
        <token>vår</token>
        <token postag="NN:OF:S.*:NEU" postag_regexp="yes">
          <!-- same "grund"/"var" ambiguities as the other NEU-matching
               possessive rules above -->
          <exception regexp="yes">grund|var</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är neutrum (ett-ord) och styr då "vårt" istället för "vår". Menade du: <suggestion>vårt \2</suggestion>?</message>
      <example correction="vårt hus">Vi sålde <marker>vår hus</marker>.</example>
    </rule>
    <rule id="VART.UTRUM_t-ord.NN" name="Rätt genus på possessivpronomen (vår/vårt)">
      <pattern>
        <token>vårt</token>
        <token postag="NN:OF:S.*:UTR" postag_regexp="yes">
          <exception>för</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är utrum (en-ord) och styr då "vår" istället för "vårt". Menade du: <suggestion>vår \2</suggestion>?</message>
      <example correction="vår bil">Vi sålde <marker>vårt bil</marker>.</example>
    </rule>
    <rule id="ER.NEUTRAL_n-ord.NN" name="Rätt genus på possessivpronomen (er/ert)">
      <pattern>
        <token>er</token>
        <token postag="NN:OF:S.*:NEU" postag_regexp="yes">
          <!-- "er" is riskier than the other possessives: it doubles as the
               object-pronoun form of "ni" (you), so "vi bryr er om ...",
               "jag ger er ..." etc. are extremely common and put all sorts
               of unrelated nouns right after "er". Confirmed 3 real cases
               against corpus text before excluding: "men" (but) also means
               "harm/injury" (archaic legal, neuter); "väl" (well/probably)
               also means "weal/welfare" (neuter); "dussintals" (dozens of,
               a quantifier) is also the genitive of "dussintal" (a
               dozen-count, neuter). Same "grund"/"var" ambiguities as the
               other NEU-matching possessive rules apply here too. -->
          <exception regexp="yes">grund|var|men|väl|dussintals</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är neutrum (ett-ord) och styr då "ert" istället för "er". Menade du: <suggestion>ert \2</suggestion>?</message>
      <example correction="ert hus">Ni sålde <marker>er hus</marker>.</example>
      <example>Det brydde ni er väl inte om?</example>
      <example>Jag förklarade varför samtalet gick till er men inte varför.</example>
      <example>Jag skulle kunna ge er dussintals exempel.</example>
    </rule>
    <!-- Tried and deliberately NOT added: predicative adjective agreement
         (NOUN + copula + adjective, e.g. "Huset är stor" -> "stort").
         Verified against the full treebank corpus (2026-09-09) and found
         genuinely unsafe, not just missing a short exception list: 16 false
         positives in 11,734 sentences, from two distinct, compounding
         causes. (1) Lexical: many common intensifying adverbs (helt, litet,
         väsentligt, betydligt, avogt, ...) are formed from an adjective's
         neuter form plus no visible change ("-t" is both the neuter
         adjective ending and the regular adverb-from-adjective ending in
         Swedish), so they carry a stray JJ:PN reading and get misread as
         the predicative adjective itself, e.g. "bilen är helt torr" matches
         on "helt", never reaching the real (correctly inflected) "torr".
         This is a systematic, productive word-formation pattern, not a
         handful of coincidences, no realistic exception list closes it.
         (2) Structural: the noun immediately before a copula isn't reliably
         the grammatical subject, e.g. "Mitt första samtal med direktören
         var egendomligt" matches "direktören" (object of a preposition) as
         if it were the subject, missing the true, more distant subject
         "samtal" entirely. Fixing this needs real subject-finding, not
         3-token adjacency. Left here as a documented dead end so this
         specific approach isn't re-attempted without a different design
         (e.g. requiring the adverb-derived-from-adjective ambiguity to be
         resolved some other way, or a fundamentally different pattern that
         doesn't assume subject-adjacency). See implementation-plan.md. -->
    <rule id="ERT.UTRUM_t-ord.NN" name="Rätt genus på possessivpronomen (er/ert)">
      <pattern>
        <token>ert</token>
        <token postag="NN:OF:S.*:UTR" postag_regexp="yes">
          <exception>för</exception>
        </token>
      </pattern>
      <message>Substantivet "\2" är utrum (en-ord) och styr då "er" istället för "ert". Menade du: <suggestion>er \2</suggestion>?</message>
      <example correction="er bil">Ni sålde <marker>ert bil</marker>.</example>
    </rule>
    <rule id="ART_VB.n-ord" name="Rätt kongruensböjning av artikel">
      <pattern>
        <token>ett</token>
        <token postag="VB:PPC:.*" postag_regexp="yes">
          <exception postag="VB:PPC:NEU"/>
        </token>
        <token postag="NN:OF:S.*:UTR" postag_regexp="yes"/>
      </pattern>
      <message>Verbet i particip är böjt i utrum (\2) och bör då föregås av ordet "en" istället för "ett", alternativt böjas i neutrum. Menade du: <suggestion>en \2 \3</suggestion>?</message>
      <example correction="en urholkad sten">Det var <marker>ett urholkad sten</marker>. </example>
    </rule>
    <rule id="ART_VB_NN.n-ord" name="Kongruensböjning">
      <pattern>
        <token>en</token>
        <token postag="VB:PPC:.*" postag_regexp="yes">
          <exception postag="VB:PPC:UTR"/>
        </token>
        <token postag="NN:OF:S.*:UTR" postag_regexp="yes"/>
      </pattern>
      <message>Verbet i particip är böjt i neutrum (\2) men ska böjas i utrum som huvudordet (och artikeln). Menade du <suggestion>en <match no="2" postag="VB:PPC:UTR" /> \3</suggestion>?</message>
      <example correction="en urholkad sten">Det var <marker>en urholkat sten</marker>. </example>
    </rule>
    <rule id="ART_VB.t-ord" name="Rätt kongruensböjning av artikel">
      <pattern>
        <token>en</token>
        <token postag="VB:PPC:.*" postag_regexp="yes">
          <exception postag="VB:PPC:UTR"/>
        </token>
        <token postag="NN:OF:S.*:NEU" postag_regexp="yes"/>
      </pattern>
      <message>Verbet "\2" i particip är böjt i neutrum och bör då föregås av ordet "ett" istället för "en", alternativt böjas i utrum. Menade du <suggestion>ett \2 \3</suggestion>?</message>
      <example correction="ett förvånat uppvaknande">Det var <marker>en förvånat uppvaknande</marker>. </example>
    </rule>
    <rule id="ART_VB_NN.t-ord" name="Kongruensböjning">
      <pattern>
        <token>ett</token>
        <token postag="VB:PPC:.*" postag_regexp="yes">
          <exception postag="VB:PPC:NEU"/>
        </token>
        <token postag="NN:OF:S.*:NEU" postag_regexp="yes"/>
      </pattern>
      <message>Verbet i particip är böjt i utrum (\2) men ska böjas i neutrum som huvudordet (och artikeln). Menade du <suggestion>ett <match no="2" postag="VB:PPC:NEU" /> \3</suggestion>?</message>
      <example correction="ett urladdat batteri">Det var <marker>ett urladdad batteri</marker>. </example>
    </rule>
    <rulegroup id="FORRE_FORE_TITEL" name="Förre före titel">
      <rule>
        <pattern case_sensitive="no">
          <token>förra</token>
          <token regexp="yes">chefen|ordförande</token>
          <token regexp="yes">på|för</token>
        </pattern>
        <message>Före titlar bör det stå <suggestion>förre \2 \3</suggestion> och inte förra \2 \3. Detta oavsett om det är en kvinna eller man som innehaft posten.</message>
        <example correction="Förre chefen på"><marker>Förra chefen på</marker> Arla var en trevlig prick.</example>
      </rule>
    </rulegroup>
    <rule id="EJ_FORE_ATT"
          name="Ord som ej bör stå före infinitivmärket &quot;att&quot;">
      <pattern case_sensitive="no">
        <token regexp="yes">kunde|brukade</token>
        <token>att</token>
      </pattern>
      <message>Infinitivmärket "att" bör inte förekomma efter <suggestion>\1</suggestion>.</message>
      <example correction="brukade">Han <marker>brukade att</marker> komma sent.</example>
    </rule>   
    <!-- Ett försök att fånga upp anföringsverb som ska föregås av ett kommatecken -->
    <rule id="KommaFoereAnfoeringsverb" name="Kommatecken före anföringsverb" default="off">
      <pattern>
        <token><exception regexp="yes">,|vad|visst</exception></token>
        <marker>
          <token regexp="yes">sade|sa|menade|viskade|skrek</token>
          <token postag="PM:.*" postag_regexp="yes"/>
        </marker>
      </pattern>
      <message>Kommatecken ska sättas ut före anföringsverb, dvs. <suggestion>, \2 \3</suggestion></message>
      <example>Det var finfint<marker>, sade Johan</marker>.</example>
      <example correction=", sade Johan">Det var finfint<marker> sade Johan</marker>.</example>
    </rule>
    <rule id="EnKlubbaTill" name="Klumpiga ordföljder 1">
      <pattern>
        <token regexp="yes">en|ett</token>
        <token>till</token>
        <token postag="NN.*" postag_regexp="yes"/>
      </pattern>
      <message>Denna ordföljd är ofta otydlig, försök med att flytta "till" efter substantivet eller byt ut det mot ytterligare. Dvs. prova att skriva <suggestion>\1 \3 \2</suggestion>.</message>
      <example correction="en klubba till">Det är nog bäst att du får <marker>en till klubba</marker>.</example>
    </rule>
  </category>
  <!-- ====================================================================== -->
  <!-- Felaktiga sammansättningar som Hunspell godkänner... -->
  <!-- ====================================================================== -->
  <category id="COMPOUNDING" name="Compound_problems">
    <rule id="OVERRENS" name="Över_rens">
      <pattern>
        <token>överrens</token>
      </pattern>
      <message>Du menar antagligen <suggestion>överens</suggestion>.</message>
      <example correction="överens">Flickorna kom <marker>överrens</marker>. </example>
    </rule>
    <rule id="MASERA" name="mas_era">
      <pattern>
        <token>masera</token>
      </pattern>
      <message>Du menar antagligen <suggestion>massera</suggestion> om du inte skriver om masarnas era förstås.</message>
      <example correction="massera">Kan du <marker>masera</marker> mig?</example>
    </rule>
  </category>
  
  <category id="CAT4" name="Ord som ofta förväxlas">
    <rule id="mottoVSmatto" name="Motto vs. måtto">
      <pattern>
        <token>i</token>
        <token regexp="yes">möjligaste|så</token>
        <token>motto</token>
      </pattern>
      <message>I dessa uttryck används ordet måtto (från måtta) och inte motto (som betyder ung. valspråk)</message>
      <example>Alla hinder bör <marker>i möjligaste måtto</marker> undanröjas.</example>
      <example correction="">Alla hinder bör <marker>i möjligaste motto</marker> undanröjas.</example>
    </rule>
  </category>
  <!-- ====================================================================== -->
  <!-- Ord som hör ihop -->
  <!-- ====================================================================== -->
  <category id="CAT5" name="Ord som hör ihop">
    <rule id="AD" name="ad ...">
      <pattern>
        <token>ad</token>
        <token>
          <exception regexp="yes">hoc|notam|acta</exception>
        </token>
      </pattern>
      <message>Detta ord brukar sällan stå ensamt på svenska. Menade du <suggestion>ad hoc</suggestion>, <suggestion>ad acta</suggestion> eller <suggestion>ad notam</suggestion>?</message>
      <example correction="ad hoc|ad acta|ad notam">
        <marker>ad foobar</marker>
      </example>
      <example>ad acta</example>
    </rule>
    <rule id="LOS" name="los ...">
      <pattern>
        <marker>
          <token>los</token>
        </marker>
        <token>
          <exception regexp="yes">angeles|lobos</exception>
        </token>
      </pattern>
      <message>Menade du <suggestion>loss</suggestion> som i "släppa taget om", eller är det en del av ett namn?</message>
      <example>Los Angeles</example>
      <example correction="Loss"><marker>Los</marker> Foobar</example>
    </rule>
  </category>
  <!-- ====================================================================== -->
  <!-- Syntax -->
  <!-- ====================================================================== -->
  <category id="CAT6" name="Syntax">
    <rule id="Forkortning" name="Böjning av förkortningar\...">
      <pattern>
        <token regexp="yes">^(\p{Lu}{2}+[i]*\p{Lu}+[\p{L}&amp;&amp;[^\p{Lu}]]{1,4}+)</token>
      </pattern>
      <message>Förkortningar som böjs binds ihop med ett kolon: <suggestion><match
            no="1"
            regexp_match="^(\p{Lu}{2}+[i]*\p{Lu}+)([\p{L}&amp;&amp;[^\p{Lu}]]{1,4}+)"
            regexp_replace="$1:$2"></match></suggestion> </message>
      <example>Med det nya API:s fördelar, kan du hitta nya lösningar.</example>
      <example correction="API:s">Med det nya <marker>APIs</marker> fördelar, kan du hitta nya lösningar.</example>
    </rule>
    <rule id="ORDNINGSTAL" name="Ordningstal">
      <pattern>
        <token regexp="yes">^(1a|2a|[\d]*[1-2]e)</token>
      </pattern>
      <message>Siffror med ändelser binds ihop med ett kolon: <suggestion><match
            no="1" regexp_match="^(1|2|[\d]*[12])(a|e)" regexp_replace="$1:$2"></match></suggestion></message>
      <example>Hon kom på 2:a plats</example>
      <example correction="2:a">Hon kom på <marker>2a</marker> plats</example>
    </rule>
    <rule id="ORDNINGSTAL2" name="Ordningstal2">
      <pattern>
        <token regexp="yes">^([3-90][ae]|[\d]*[3-90][e]|[^1]*[012][ae])</token>
      </pattern>
      <message>Siffror med ändelser binds ihop med ett kolon: <suggestion><match
            no="1" regexp_match="^([3-90]|[\d]*[3-90])([ae])"
            regexp_replace="$1:$2"></match></suggestion></message>
      <example>Han kom på 5:e plats</example>
      <example correction="5:e">Han kom på <marker>5e</marker> plats</example>
    </rule>
  </category>
<!--================================================
Kontamination
dvs. ihopblandning av besläktade ord. 
Exempelvis "ta självmord" vilket antingen heter:
"begå självmord" eller "ta sitt liv"
===============================================-->
  <category id="CAT7" name="Kontamination">
    <rule id="NEG_PLANER_OM" name="Planer om">
      <pattern case_sensitive="no">
        <token>planer</token>
        <token>om</token>
      </pattern>
      <message>Undvik att blanda konstruktioner. "Planer om" bör vara <suggestion>planer på</suggestion> eller <suggestion>drömmar om</suggestion>.</message>
      <example correction="planer på|drömmar om">Hon hade stora <marker>planer om</marker> det nya systemet.</example>
      <example>Hon hade stora <marker>drömmar om</marker> det nya systemet</example>
      <example>Hon hade stora <marker>planer på</marker> förändringar.</example>
    </rule>
    <rule id="MELLAN_TILL" name="Mellan klockan fem till tio">
      <pattern case_sensitive="no">
        <token>mellan</token>
        <token regexp="yes">klockan|kl|kl\.</token>
        <token/>
        <token>till</token>
        <token/>
      </pattern>
      <message>Undvik att blanda två konstruktioner. Skriv hellre <suggestion>\1 \2 \3 och \5</suggestion> än \1 \2 \3 \4 \5.</message>
      <example correction="Mellan klockan två och fyra"><marker>Mellan klockan två till fyra</marker>.</example>
    </rule>
    <rule id="NEG_TA_SJALVMORD" name="Ta självmord">
      <pattern case_sensitive="no">
        <token>ta</token>
        <token>självmord</token>
      </pattern>
      <message>Undvik att blanda konstruktioner. "Ta självmord" bör vara <suggestion>begå självmord</suggestion>, <suggestion>ta ditt liv</suggestion> eller <suggestion>ta sitt liv</suggestion>.</message>
      <example correction="begå självmord|ta ditt liv|ta sitt liv">Har du någonsin funderat på att <marker>ta självmord</marker>.</example>
      <example>Har du någonsin funderat på att <marker>begå självmord</marker>.</example>
    </rule>
    <rule id="NEG_MELLAN_SYD_TILL_NORD" name="Mellan syd till nord">
      <pattern>
        <token>mellan</token>
        <token postag="PM.*" postag_regexp="yes"></token>
        <token>till</token>
        <token postag="PM.*" postag_regexp="yes"></token>
      </pattern>
      <message>Undvik att blanda konstruktioner. Använd antingen <suggestion>mellan \2 och \4</suggestion> eller <suggestion>från \2 till \4</suggestion></message>
      <example correction="Mellan Stockholm och Skara|Från Stockholm till Skara"><marker>Mellan Stockholm till Skara</marker> finns inget intressant.</example>
      <example><marker>Mellan Stockholm och Skara</marker> finns inget intressant.</example>
    </rule>
    <rule id="I_STOR_GRAD" name="I stor grad &gt; i hög grad">
      <pattern case_sensitive="no">
        <token>i</token>
        <token>stor</token>
        <token>grad</token>
      </pattern>
      <message>Använd hellre <suggestion>i hög grad</suggestion> än "i stor grad".</message>
      <example correction="i hög grad">Affärens kunder är <marker>i stor grad</marker> nöjda med servicen.</example>
    </rule>
    <rule id="NEG_KLAGOMAL_MOT"
          name="Framföra klagomål &quot;mot&quot; någon ej &quot;över&quot;">
      <pattern case_sensitive="no">
        <token>klagomål</token>
        <token>över</token>
      </pattern>
      <message>Man framför <suggestion>klagomål mot</suggestion> någon, inte "över" någon.</message>
      <example correction="klagomål mot">Maria framförde sina <marker>klagomål över</marker> socialen.</example>
    </rule>
    <rule id="NEG_ANGRA_PA_ATT" name="Ångra på att &gt; Ångra att">
      <pattern case_sensitive="no">
        <token regexp="yes">ångra|ångrar|ångrade</token>
        <token>på</token>
        <token>att</token>
      </pattern>
      <message>Man ångrar inte "på" något utan man ångrar något. Skriv därför inte "\1 \2 \3" utan skriv <suggestion>\1 \3</suggestion>.</message>
      <example correction="ångrade att">Hon <marker>ångrade på att</marker> hon suttit ensam hemma den fredagen.</example>
    </rule>
  </category>
  <category id="SSK_8" name="Stor eller liten bokstav">
    <rule id="VECKODAGARS_NAMN" name="Veckodagars namn">
      <antipattern case_sensitive="yes">
        <token regexp="yes">&weekdays;</token>
      </antipattern>
      <antipattern>
         <token postag="SENT_START" />
         <token regexp="yes">&weekdays;</token>
      </antipattern>
      <pattern>
        <token regexp="yes">&weekdays;</token>
      </pattern>
      <message>Veckodagars namn skrivs med inledande gemen bokstav. Skriv <suggestion><match no="1" case_conversion="startlower" /></suggestion> inte "\1".</message>
      <example correction="måndag">idag är det <marker>Måndag</marker>.</example>
    </rule>	
    <rule id="MÅNADERS_NAMN" name="Månaders namn">
      <antipattern case_sensitive="yes">
        <token regexp="yes">&months;</token>
      </antipattern>
      <antipattern>
        <token postag="SENT_START" />
        <token regexp="yes">&months;</token>
      </antipattern>
      <pattern>
      	<token regexp="yes">&months;</token>
      </pattern>
      <message>Månaders namn skrivs med inledande gemen bokstav. Skriv <suggestion><match no="1" case_conversion="startlower" /></suggestion> inte "\1".</message>
      <example correction="september">Den bästa månaden är <marker>September</marker>.</example>
    </rule>
  </category>
</rules>
